# Copie ce fichier en .env.local (développement) ou renseigne ces variables chez
# l'hébergeur. Aucune n'est nécessaire pour construire le site : sans elles, les
# formulaires enregistrent en mémoire en développement et s'annoncent « non branchés »
# en production, l'email et WhatsApp restant affichés.

# Adresse publique du site (liens canoniques, sitemap, images de partage).
NEXT_PUBLIC_SITE_URL=https://example.com

# PostgreSQL (Neon, Supabase…), connexion poolée. Migrations : npm run db:migrate.
DATABASE_URL=postgresql://user:password@host:5432/ceexfolio?sslmode=require

# memory : demandes gardées en mémoire, pour les tests (jamais en production).
# CONTACT_STORE=memory

# Resend : notification à chaque demande et accusé de réception au client.
# RESEND_FROM doit utiliser un domaine vérifié chez Resend.
RESEND_API_KEY=
RESEND_FROM="CEEXFolio <contact@example.com>"
# Destinataire des notifications ; par défaut l'email affiché sur le site.
# CONTACT_NOTIFY_TO=

# Cloudflare Turnstile : les deux clés, ou aucune.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Envois permis par adresse IP et par heure (5 par défaut).
# CONTACT_RATE_LIMIT=5

# Clé de l'empreinte HMAC des adresses IP (limite d'envois).
# openssl rand -hex 32
IP_HASH_SECRET=

# Coulisses : connexion GitHub réservée à un seul compte. Sans l'une de ces variables
# (ou sans DATABASE_URL), personne n'entre.
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Adresse publique du site ; par défaut NEXT_PUBLIC_SITE_URL.
# BETTER_AUTH_URL=https://example.com
# Application OAuth GitHub, URL de retour : <site>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Ton identifiant GitHub numérique (champ « id » de https://api.github.com/users/<pseudo>).
ALLOWED_GITHUB_ID=
